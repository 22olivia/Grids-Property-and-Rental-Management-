# ---------------------------------------------------------------------------
# GPMS frontend environment
#
# Backend: Laravel 13 + Sanctum. Base path INCLUDES the version prefix.
# Health check lives at {base}/health.
# ---------------------------------------------------------------------------

# Only used when NEXT_PUBLIC_DATA_SOURCE=http.
# Verified from the backend README: http://127.0.0.1:8000/api/v1 for local.
# The path INCLUDES the /api/v1 version prefix.
GPMS_API_BASE_URL=http://127.0.0.1:8000/api/v1
GPMS_API_TIMEOUT_MS=15000

# 'mock' runs the whole UI offline with sample data — no backend needed.
# 'http' uses the real GPMS API through the BFF for assets and authentication.
#
# Defaults to 'mock' so a fresh clone runs immediately. Switch to 'http' once
# the Laravel API is running locally.
#
# Listings and CRM ignore this setting and always use sample data, because the
# backend has no endpoints for them.
NEXT_PUBLIC_DATA_SOURCE=mock

# Public origin of this application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cookie holding the Sanctum token server-side. The browser never reads it.
SESSION_COOKIE_NAME=gpms_session

# Display currency for unit rents and charges.
# The backend stores no currency on rental_units, contracts or invoices — only
# on payments (char(3), default AED). Until FR-FIN-002 multi-currency exists
# server-side, this is the single display currency.
NEXT_PUBLIC_DEFAULT_CURRENCY=AED

# ---------------------------------------------------------------------------
# Deliberately absent — no provider selected, and no secret belongs in source:
#   map / geocoding keys, payment gateway keys, analytics keys.
# The backend holds the payment gateway credentials (config/payments.php);
# the frontend never handles card data (FR-SEC-008).
# ---------------------------------------------------------------------------
