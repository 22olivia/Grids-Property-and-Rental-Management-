APP_NAME="Grids GPMS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend origin (password-reset links + future CORS allowlist)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — MySQL (local or Railway)
# ---------------------------------------------------------------------------
# Local:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rental
DB_USERNAME=rental
DB_PASSWORD=rental_secret
#
# Railway MySQL (set these on the API service — see RAILWAY.md):
# DB_CONNECTION=mysql
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# Or: DB_URL=${{MySQL.MYSQL_URL}}
#
# Free tier: SEED_ON_BOOT=1 once, then 0. Prefer CACHE_STORE=file + QUEUE_CONNECTION=sync.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Free / Railway: use sync (no worker). Local can use database.
QUEUE_CONNECTION=sync

# Free / Railway: file cache. Local can use database.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail — Resend (recommended), Brevo, SMTP, or log
# ---------------------------------------------------------------------------
# Resend:
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_xxx
# Brevo SMTP:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-brevo-login
#   MAIL_PASSWORD=your-brevo-smtp-key
# Log only (local/demo):
#   MAIL_MAILER=log
#
# Email — Gmail SMTP example (use a Google App Password, not your login password):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=smtp
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=your-16-char-app-password
#   MAIL_FROM_ADDRESS="you@gmail.com"
# For local demos without SMTP: MAIL_MAILER=log
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@grids.test"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp (Twilio). Leave blank to simulate WhatsApp delivery in logs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SMS_FROM=

RESEND_API_KEY=

# n8n Cloud — outbound support.ticket_created (never blocks ticket create).
# n8n assigns maintainers via POST /support/tickets/{id}/assign + login Bearer token (see N8N.md).
# Skip close/resolve in n8n — use Help & Support in GPMS.
N8N_ENABLED=true
N8N_WEBHOOK_TICKET_URL=https://gridsgpms.app.n8n.cloud/webhook/gpms-ticket
# Optional shared secret (sent as X-GPMS-N8N-Secret on outbound only)
N8N_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Payments — demo (default) or Paytm staging/production
# ---------------------------------------------------------------------------
# demo: full local order → confirm/webhook → payment + receipt + invoice update
# paytm: set PAYMENT_GATEWAY=paytm and merchant credentials (staging MID/key)
# Quote PAYTM_MERCHANT_KEY if it contains & or other special characters.
PAYMENT_GATEWAY=demo
PAYMENT_CURRENCY=AED
PAYMENT_WEBHOOK_SECRET=demo-verified
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_BASE_URL=https://securegw-stage.paytm.in

# Railway only: seed demo users on first boot, then set to 0
# SEED_ON_BOOT=0
